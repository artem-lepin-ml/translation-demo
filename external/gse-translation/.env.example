# Copy to .env (gitignored) and fill in real values.
# OpenAI direct — used by the small gpt-5.4-mini entry.
OPENAI_API_KEY=
# OpenRouter — used by every OR-routed entry (the 3 small + 5 large entries).
OPENROUTER_API_KEY=
# Optional. When set, overrides https://openrouter.ai/api/v1 at runtime for
# every OR-routed entry. Leave empty to use OpenRouter directly. Never
# commit the override value — it lives only in your local .env.
# OPENROUTER_BASE_URL=
VLLM_API_KEY="EMPTY"